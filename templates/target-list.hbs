<details
  {{#unless collapsed}}open{{/unless}}
  class="{{moduleId}}-target-list"
  data-visibility="gm"
>
<summary>{{{summary}}}</summary>
  {{#each targetList}}
    <div class="{{@root.moduleId}}-target"
      {{#if @root.showTicker}}
        {{#if @root.swap}}
          data-target="{{@root.originId}}"
          data-origin="{{targetId}}"
        {{else}}
          data-origin="{{@root.originId}}"
          data-target="{{targetId}}"
        {{/if}}
      {{/if}}
    >
      {{#if coverTooltips}}
        <i class="fa-regular fa-shield"
          data-tooltip="<div>
            {{#each coverTooltips}}
              {{#unless @first}}<br>{{/unless}}{{this}}
            {{/each}}
          </div>"
        ></i>
      {{/if}}
      <div class="{{@root.moduleId}}-name">{{vs}}</div>
      <div
        class="{{@root.moduleId}}-result"
        {{#if clickId}}data-click-id="{{clickId}}"{{/if}}
        data-interactive="{{@root.interactive}}"
      >
        <span class="degree-of-success {{dos}}">{{localize label}}</span>
      </div>
      <div class="{{@root.moduleId}}-dc">
        <span class="degree-of-success {{dos}}">{{dc}}</span>
        {{#if tooltips}}
          <i class="fas fa-info-circle"
            data-tooltip="<div>
              {{#each tooltips}}
                {{#unless @first}}<br>{{/unless}}{{this}}
              {{/each}}
            </div>"
          ></i>
        {{/if}}
      </div>
    </div>
  {{/each}}
</details>
