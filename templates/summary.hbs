<div class="{{moduleId}}-summary" data-visibility="gm">
  {{#if observedLabel}}
    <span class="{{moduleId}}-observed">{{observedLabel}}</span>`
  {{/if}}
  {{#if hiddenLabel}}
    <span class="{{moduleId}}-hidden">{{hiddenLabel}}</span>`
  {{/if}}
  {{#if undetectedLabel}}
    <span class="{{moduleId}}-undetected">{{undetectedLabel}}</span>`
  {{/if}}
</div>
