<footer class="{{moduleId}}-dialog-footer flexrow">
  <button type="button" data-action="cancel">
    <i class="fa-solid fa-xmark"></i>{{localize cancelLabel}}
  </button>
  <button type="button"
    data-action="confirm"
    class="dialog-button default"
    {{#if confirmDisabled}}disabled{{/if}}
  >
    <i class="fa-solid fa-check"></i>{{localize confirmLabel}}
  </button>
</footer>

