<div class="{{moduleId}}-end-stealth" data-visibility="gm">
  <button
    type="button"
    class="{{moduleId}}-split-button primary-side"
    data-click-id="{{primaryClickId}}"
    {{#unless change}}disabled{{/unless}}
    {{#if primaryTooltip}}
      title="{{primaryTooltip}}"
    {{/if}}
  >
    <i class="fas fa-eye"></i> {{localize primaryLabel}}
  </button>
  {{#if secondaryClickId}}
    <button
      type="button"
      class="{{moduleId}}-split-button secondary-side"
      data-click-id="{{secondaryClickId}}"
      {{#if secondaryTooltip}}
        title="{{secondaryTooltip}}"
      {{/if}}
    >
      <i class="fas fa-eye-slash"></i> {{localize secondaryLabel}}
    </button>
  {{/if}}
</div>
 
